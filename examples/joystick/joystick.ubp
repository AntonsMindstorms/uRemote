module main
author unknown
version 1 0 
description ''

  spec 'r' 'joy' 'joy'

to joy {
  local 'bytes' ('[data:newByteArray]' 3)
  '[sensors:i2cRead]' (hexToInt '52') bytes
  return ('[data:makeList]' (at 1 bytes) (at 2 bytes) (at 3 bytes))
}

script 199 66 {
whenStarted
init
forever {
  process
}
}

script 40 219 {
to joy {}
}


module uremote
author Ste7an
version 1 5 
description 'UART RPC for MicroBlocks. Receive timeout 1000 ms and inter-byte timeout 10 ms are fixed.'
variables _last_error

  spec ' ' 'init' 'uremote init'
  spec 'r' 'call' 'uremote call _ data _' 'str auto' 'Command' <Reporter v>
  spec 'r' 'last error' 'uremote last error'
  spec ' ' 'process' 'uremote process'
  spec 'r' '_encode' 'encode _ _ data _' 'num str auto' '0 Command' <Reporter v>
  spec 'r' '_wait and read serial' 'wait and read serial'
  spec 'r' '_decode' 'decode _' 'auto' '10'
  spec ' ' '_send command' 'send command _ _ data _' 'num str auto' '0 Command' <Reporter v>
  spec 'r' '_receive command' 'receive command'
  spec ' ' 'flush' 'flush'

to '_decode' encoded {
  local 'tot_len' (size encoded)
  local 'var_list' ('[data:makeList]')
  local 'hdr' (at 1 encoded)
  local 'l' (mod hdr 32)
  local 'status' (/ (- hdr l) 32)
  local 'p' 2
  local 'cmd' ('[data:newByteArray]' l)
  for i l {
    atPut i cmd (at ((i + p) - 0) encoded)
  }
  cmd = ('[data:convertType]' cmd 'string')
  p += l
  repeatUntil (p > tot_len) {
    local 'type' (at p encoded)
    p += 1
    l = (at p encoded)
    local 'bytes' ('[data:newByteArray]' l)
    for i l {
      atPut i bytes (at ((i + p) - 0) encoded)
    }
    comment '78 = N -> number'
    if (type == 78) {
      bytes = ('[data:convertType]' ('[data:convertType]' bytes 'string') 'number')
    } (type == 83) {
      comment '83 = S -> string'
      bytes = ('[data:convertType]' bytes 'string')
    } (type == 65) {
      comment '65 = A -> bytesarray'
    } (type == 66) {
      comment '66 = B -> boolean'
      bytes = ('[data:convertType]' (at 1 bytes) 'boolean')
    } else {
      _last_error = ('[data:join]' 'decode: unknown type ' ('[data:convertType]' type 'string'))
      return ('[data:makeList]')
    }
    p += (l + 1)
    var_list = ('[data:join]' var_list ('[data:makeList]' bytes))
  }
  return ('[data:makeList]' status cmd var_list)
}

to '_encode' status cmd list {
  if (not (isType list 'list')) {list = ('[data:makeList]' list)}
  local 'list_len' (size list)
  local 'all_bytes' ('[data:newByteArray]' 0)
  for i list_len {
    local 'var' (at i list)
    local 'bytes' ('[data:newByteArray]' 0)
    if (isType var 'number') {
      comment '78 = N -> number'
      local 'str' ('[data:convertType]' var 'string')
      bytes = ('[data:join]' ('[data:asByteArray]' ('[data:makeList]' 78 (size str))) ('[data:convertType]' str 'byte array'))
    } (isType var 'boolean') {
      if var {
        local 'bool' 1
      } else {
        local 'bool' 0
      }
      comment '66 = B -> boolean'
      bytes = ('[data:asByteArray]' ('[data:makeList]' 66 1 bool))
    } (isType var 'string') {
      comment '83 = S -> string'
      bytes = ('[data:join]' ('[data:asByteArray]' ('[data:makeList]' 83 (size var))) ('[data:convertType]' var 'byte array'))
    } (isType var 'byte array') {
      comment '65 = A -> bytesarray'
      bytes = ('[data:join]' ('[data:asByteArray]' ('[data:makeList]' 65 (size var))) var)
    } else {
      comment 'skip unsupported type'
    }
    if ((size bytes) > 0) {
      all_bytes = ('[data:join]' all_bytes bytes)
    }
  }
  all_bytes = ('[data:join]' ('[data:asByteArray]' (+ (* status 32) (size cmd))) ('[data:asByteArray]' cmd) all_bytes)
  return all_bytes
}

to '_receive command' {
  local 'bytes' ('_wait and read serial')
  if ((size bytes) > 0) {
    return ('_decode' bytes)
  }
  return ('[data:makeList]')
}

to '_send command' status cmd data {
  local 'PREAMBLE' ('[data:asByteArray]' '<$MU')
  local 'bytes' ('[data:join]' PREAMBLE ('_encode' status cmd data))
  if ((size bytes) > 255) {
    _last_error = 'frame too large'
    return
  }
  bytes = ('[data:join]' ('[data:asByteArray]' (size bytes)) bytes)
  '[serial:write]' bytes
}

to '_wait and read serial' {
  local 'byte' 0
  local 'PREAMBLE' ('[data:asByteArray]' '<$MU')
  local 'start_time' (millisOp)
  local 'tot_len' 0
  waitUntil (or (((millisOp) - start_time) > 1000) (('[serial:available]') > 0))
  if (('[serial:available]') > 0) {
    tot_len = (at 1 ('[serial:readNr]' 1))
  } else {
    local 'tmp' ('[serial:read]')
    _last_error = 'timeout: no length byte'
    return ('[data:newByteArray]' 0)
  }
  local 'buf' ('[data:newByteArray]' (tot_len - 4))
  local 'idx' 1
  local 'frameStart' (millisOp)
  local 'byteStart' (millisOp)
  repeatUntil (idx > tot_len) {
    if (((millisOp) - frameStart) > 1000) {
      local 'tmp' ('[serial:read]')
      _last_error = 'timeout: incomplete frame'
      return ('[data:newByteArray]' 0)
    }
    if (('[serial:available]') > 0) {
      byte = (at 1 ('[serial:readNr]' 1))
      if (idx < 5) {
        comment 'check preamble'
        if (byte != (at idx PREAMBLE)) {
          local 'tmp' ('[serial:read]')
          _last_error = 'preamble mismatch'
          return ('[data:newByteArray]' 0)
        }
      } else {
        atPut (idx - 4) buf byte
      }
      idx += 1
      byteStart = (millisOp)
    } else {
      if (((millisOp) - byteStart) > 10) {
        local 'tmp' ('[serial:read]')
        _last_error = 'timeout: inter-byte gap'
        return ('[data:newByteArray]' 0)
      }
    }
  }
  return buf
}

to call cmd data {
  _last_error = ''
  '_send command' 0 cmd data
  local 'rcv' ('_receive command')
  if ((size rcv) == 0) {
    if (_last_error == '') {
      _last_error = 'no bytes received'
    }
    return
  }
  local 'status' (at 1 rcv)
  local 'reply_cmd' (at 2 rcv)
  local 'rcv_data' (at 3 rcv)
  if (not (reply_cmd == cmd)) {
    _last_error = ('[data:join]' 'unexpected reply: ' reply_cmd)
    return
  }
  if (status > 0) {
    if ((size rcv_data) == 1) {
      _last_error = (at 1 rcv_data)
    } else {
      _last_error = 'remote error'
    }
    return
  }
  _last_error = ''
  if ((size rcv_data) == 1) {
    return (at 1 rcv_data)
  } else {
    return rcv_data
  }
}

to 'last error' {
  return _last_error
}

to flush {
  local 'var' 0
  repeatUntil (('[serial:available]') == 0) {
    var = ('[serial:read]')
  }
}

to init {
  comment 'init serial port at 115200 and empty buffer'
  _last_error = ''
  '[serial:open]' 115200
  local 'var' ('[serial:read]')
}

to process {
  local 'cmd_data' ('_receive command')
  if (not ((size cmd_data) == 0)) {
    local 'status' (at 1 cmd_data)
    local 'cmd' (at 2 cmd_data)
    local 'data' (at 3 cmd_data)
    if ((callCustomReporter '[vars:functionExists]' ('[data:makeList]' cmd))) {
      local 'return' (callCustomReporter cmd data)
      if (not (isType return 'list')) {
        return = ('[data:makeList]' return)
      }
      '_send command' 0 cmd return
    } else {
      '_send command' 1 cmd ('[data:join]' 'handler not found: ' cmd)
    }
  }
}
